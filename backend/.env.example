NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Supabase > Project Settings > API. Keep the service_role key on the server only.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Supabase > Connect > Transaction pooler. Used by NestJS only.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres
DATABASE_CA_CERT=certs/supabase-prod-ca-2021.crt

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUMENT_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
